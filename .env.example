# Environment Configuration
NODE_ENV=development
PORT=7357

# Database
DATABASE_URL=file:./dev.db

# GitHub Integration
GITHUB_TOKEN=ghp_your_personal_access_token_here
ALLOWED_REPOS=your-username/test-repo,your-org/another-repo

# HTTP Transport (Phase 2.5)
TRANSPORTS=stdio,http
BASE_PATH=/mcp

# Authentication disabled for personal use (no tokens required)
# NO_AUTH=true

# Safety & Limits
DRY_RUN=true
MAX_FILE_SIZE_MB=1
MAX_PATCH_SIZE_MB=10

# Idempotency (Phase 2.5)
IDEMPOTENCY_REQUIRED=false
REQUEST_ID_HEADER=x-request-id

# Logging
LOG_LEVEL=debug

# Retry Configuration
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=1000

# Health Check
HEALTH_CHECK_ENABLED=true
