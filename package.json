{
  "name": "taskhub-mcp",
  "version": "1.0.0",
  "description": "TaskHub MCP server that enables ChatGPT ↔ Augment ↔ GitHub workflow",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.ts",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:setup": "prisma generate && prisma db push",
    "db:reset": "prisma db push --force-reset",
    "db:studio": "prisma studio",
    "demo:happy-path": "tsx scripts/demo.ts",
    "demo:phase4": "node scripts/test-simple-phase4.js",
    "deploy:build": "scripts/deploy.sh build",
    "deploy:start": "scripts/deploy.sh deploy",
    "deploy:stop": "scripts/deploy.sh stop"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "github",
    "chatgpt",
    "augment",
    "task-management"
  ],
  "author": "TaskHub Team",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^8.2.0",
    "@fastify/helmet": "^10.1.0",
    "@fastify/jwt": "^6.7.1",
    "@fastify/rate-limit": "^8.0.0",
    "@modelcontextprotocol/sdk": "^0.5.0",
    "@prisma/client": "^5.7.1",
    "@types/jsonwebtoken": "^9.0.10",
    "dotenv": "^16.3.1",
    "fastify": "^4.10.2",
    "jsonwebtoken": "^9.0.2",
    "octokit": "^3.2.2",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "@vitest/coverage-v8": "^1.1.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1",
    "prisma": "^5.7.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
